# Esempio di reverse proxy nginx per Forza 4, incluso il supporto agli
# upgrade WebSocket richiesti da /ws. Copia in
# /etc/nginx/sites-available/forza4.conf (o nel percorso usato dal tuo
# setup nginx), adatta server_name e porta, poi abilita il sito.
#
# Se esponi il gioco come sottodominio dedicato (es. forza4.tuodominio.it),
# usa questo file cosi' com'e'. Se invece preferisci un percorso sotto un
# dominio gia' esistente (es. tuodominio.it/forza4), sposta i due blocchi
# "location" dentro il server block di quel dominio.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name forza4.tuodominio.it;

    location /ws {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Il client manda un ping ogni 30s, quindi la connessione resta
        # comunque viva: questo timeout alto serve solo a evitare che nginx
        # la chiuda lui stesso durante una sala d'attesa lasciata aperta
        # a lungo (es. per tutta la serata).
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location / {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Dopo aver abilitato il sito e ricaricato nginx, attiva HTTPS con:
#   sudo certbot --nginx -d forza4.tuodominio.it
